{
  "colors": {
    "primary": {
      "50": "#f0fdf4",
      "100": "#dcfce7",
      "500": "#22c55e",
      "600": "#16a34a",
      "700": "#15803d"
    },
    "success": "#10b981",
    "warning": "#f59e0b",
    "error": "#ef4444",
    "info": "#3b82f6",
    "neutral": {
      "50": "#f9fafb",
      "100": "#f3f4f6",
      "200": "#e5e7eb",
      "500": "#6b7280",
      "700": "#374151",
      "900": "#111827"
    }
  },
  "typography": {
    "fontFamily": "Interop, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto",
    "sizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "weights": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "spacing": {
    "unit": "8px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1)"
  },
  "statusIcons": {
    "complete": "✓",
    "inProgress": "⏳",
    "pending": "◯",
    "error": "✕",
    "warning": "⚠️",
    "info": "ℹ️"
  },
  "buttons": {
    "primary": {
      "background": "#10b981",
      "color": "#ffffff",
      "padding": "12px 24px",
      "borderRadius": "8px",
      "fontSize": "16px",
      "fontWeight": 600,
      "cursor": "pointer",
      "border": "none",
      "hover": {
        "background": "#059669"
      },
      "disabled": {
        "background": "#d1d5db",
        "cursor": "not-allowed"
      }
    },
    "secondary": {
      "background": "transparent",
      "color": "#374151",
      "padding": "12px 24px",
      "borderRadius": "8px",
      "fontSize": "16px",
      "fontWeight": 500,
      "cursor": "pointer",
      "border": "1px solid #d1d5db",
      "hover": {
        "background": "#f9fafb",
        "borderColor": "#9ca3af"
      }
    },
    "tertiary": {
      "background": "transparent",
      "color": "#6b7280",
      "padding": "8px 16px",
      "borderRadius": "4px",
      "fontSize": "14px",
      "fontWeight": 500,
      "cursor": "pointer",
      "border": "none",
      "hover": {
        "color": "#374151"
      }
    }
  },
  "cards": {
    "padding": "24px",
    "borderRadius": "12px",
    "backgroundColor": "#ffffff",
    "border": "1px solid #e5e7eb",
    "boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1)"
  },
  "inputs": {
    "padding": "12px 16px",
    "borderRadius": "8px",
    "fontSize": "16px",
    "border": "1px solid #d1d5db",
    "backgroundColor": "#ffffff",
    "focus": {
      "borderColor": "#10b981",
      "outline": "none",
      "boxShadow": "0 0 0 3px rgba(16, 185, 129, 0.1)"
    }
  },
  "breakpoints": {
    "mobile": "640px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  }
}
